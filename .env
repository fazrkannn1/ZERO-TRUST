# ─── Konfigurasi Lingkungan Zero Trust Akademik ────────────────────────────

# JWT Secret (ganti dengan nilai acak yang kuat di produksi)
JWT_SECRET=ZeroTrustAkademik_S3cr3t_K3y_2024!

# Gateway Secret (shared secret antara gateway dan services)
GATEWAY_SECRET=Gat3way_Sh4r3d_S3cr3t_ZT_2024!

# Port
GATEWAY_PORT=3000
NILAI_PORT=3001
TRANSKRIP_PORT=3002

# URL internal services (hanya diakses oleh gateway)
NILAI_SERVICE_URL=http://localhost:3001
TRANSKRIP_SERVICE_URL=http://localhost:3002

# Service Authentication (Machine-to-Machine)
SERVICE_CLIENT_ID=gateway-service-client
SERVICE_CLIENT_SECRET=ServiceSecretKey2024!

# Jam Operasional Akses Dosen (HH:MM format)
ACCESS_HOURS_START=07:00
ACCESS_HOURS_END=21:00
